#!/bin/bash

set -Eeuo pipefail

SELKIES_PORT="${SELKIES_PORT:-8080}"

echo ""
echo "=============================================="
echo "     Starting Cloudflare Quick Tunnel"
echo "=============================================="
echo ""
echo "Waiting for Selkies on port ${SELKIES_PORT}..."
echo ""

while ! (echo > "/dev/tcp/127.0.0.1/${SELKIES_PORT}") 2>/dev/null; do
    sleep 1
done

echo "Selkies is ready."
echo ""
echo "Starting Cloudflare..."
echo ""

exec cloudflared tunnel \
    --no-autoupdate \
    --url "http://127.0.0.1:${SELKIES_PORT}"
