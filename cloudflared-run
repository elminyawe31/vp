#!/bin/sh

exec 2>&1

echo "=============================================="
echo " Cloudflare Quick Tunnel"
echo "=============================================="
echo ""

# Wait until Selkies is actually listening.
echo "Waiting for Selkies on port 8080..."

i=0
while ! (echo > /dev/tcp/127.0.0.1/8080) >/dev/null 2>&1; do
    i=$((i + 1))

    if [ "$i" -ge 120 ]; then
        echo "ERROR: Selkies did not become ready."
        exit 1
    fi

    sleep 1
done

echo "Selkies is ready."
echo ""
echo "Starting Cloudflare Quick Tunnel..."
echo ""

exec /usr/local/bin/cloudflared tunnel \
    --no-autoupdate \
    --url http://127.0.0.1:8080
